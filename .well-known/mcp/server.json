{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "help.agentpay/agentpay",
  "title": "AgentPay",
  "description": "Pay-per-call AI + crypto + data microservices via x402. 22 endpoints. USDC on Base.",
  "version": "1.2.0",
  "homepage": "https://agentpay.help",
  "repository": {
    "url": "https://github.com/ronaldanton/x402-shop",
    "source": "github"
  },
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "ronaldanton"
    }
  ],
  "server": {
    "type": "stdio",
    "entry_point": "mcp-server.js",
    "command": "node",
    "args": [
      "mcp-server.js"
    ],
    "env": {
      "SHOP_URL": "https://agentpay.help",
      "PAYMENT_NETWORK": "eip155:8453",
      "BUYER_PRIVATE_KEY": "${BUYER_PRIVATE_KEY}"
    }
  },
  "tools": [
    {
      "name": "summarize",
      "description": "AI text summarization - $0.01/call"
    },
    {
      "name": "classify-insurance",
      "description": "Insurance lead classifier - $0.02/call"
    },
    {
      "name": "sentiment",
      "description": "Sentiment analysis - $0.02/call"
    },
    {
      "name": "extract",
      "description": "Structured field extraction - $0.03/call"
    },
    {
      "name": "translate",
      "description": "Text translation - $0.03/call"
    },
    {
      "name": "code-review",
      "description": "AI code review - $0.05/call"
    },
    {
      "name": "insurance-analysis",
      "description": "Full insurance bundle - $0.10/call"
    },
    {
      "name": "token-safety",
      "description": "Token rug/honeypot check - $0.02/call"
    },
    {
      "name": "wallet-risk",
      "description": "Wallet risk screening - $0.02/call"
    },
    {
      "name": "web-scrape",
      "description": "Extract text from URL - $0.01/call"
    },
    {
      "name": "crypto-price",
      "description": "Real-time crypto prices - $0.005/call"
    },
    {
      "name": "image-describe",
      "description": "Vision AI from URL - $0.03/call"
    },
    {
      "name": "defi-yields",
      "description": "DeFi yield data - $0.01/call"
    },
    {
      "name": "threat-intel",
      "description": "CVE/threat intelligence - $0.02/call"
    },
    {
      "name": "sanctions-screen",
      "description": "OFAC/EU sanctions screening - $0.02/call"
    },
    {
      "name": "market-intel",
      "description": "Macro/economic data - $0.02/call"
    },
    {
      "name": "on-chain-events",
      "description": "Decoded on-chain events - $0.01/call"
    },
    {
      "name": "content-safety",
      "description": "PII/toxicity/bias detection - $0.02/call"
    },
    {
      "name": "agent-reputation",
      "description": "Endpoint trustworthiness - $0.01/call"
    },
    {
      "name": "legal-lookup",
      "description": "Company/VAT verification - $0.03/call"
    },
    {
      "name": "news-feed",
      "description": "Real-time news feed - $0.005/call"
    },
    {
      "name": "weather-data",
      "description": "Weather data - $0.005/call"
    }
  ],
  "payment": {
    "protocol": "x402",
    "network": "eip155:8453",
    "currency": "USDC",
    "note": "Each tool call pays the agentpay.help endpoint via x402 automatic payment from BUYER_PRIVATE_KEY wallet."
  }
}