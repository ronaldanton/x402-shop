{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "help.agentpay/agentpay",
  "title": "AgentPay",
  "description": "22 pay-per-call AI + crypto + data microservices via x402. USDC on Base.",
  "version": "1.3.0",
  "homepage": "https://agentpay.help",
  "repository": {
    "url": "https://github.com/ronaldanton/x402-shop",
    "source": "github"
  },
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "ronaldanton"
    }
  ],
  "server": {
    "type": "stdio",
    "entry_point": "mcp-server.js",
    "command": "node",
    "args": [
      "mcp-server.js"
    ],
    "env": {
      "SHOP_URL": "https://agentpay.help",
      "PAYMENT_NETWORK": "eip155:8453",
      "BUYER_PRIVATE_KEY": "${BUYER_PRIVATE_KEY}"
    }
  },
  "tools": [
    {
      "name": "summarize",
      "description": "AI text summarization"
    },
    {
      "name": "classify-insurance",
      "description": "Insurance lead classifier"
    },
    {
      "name": "sentiment",
      "description": "Sentiment analysis"
    },
    {
      "name": "extract",
      "description": "Structured field extraction"
    },
    {
      "name": "translate",
      "description": "Text translation"
    },
    {
      "name": "code-review",
      "description": "AI code review"
    },
    {
      "name": "insurance-analysis",
      "description": "Full insurance bundle"
    },
    {
      "name": "token-safety",
      "description": "Token rug/honeypot check"
    },
    {
      "name": "wallet-risk",
      "description": "Wallet risk screening"
    },
    {
      "name": "web-scrape",
      "description": "Extract text from URL"
    },
    {
      "name": "crypto-price",
      "description": "Real-time crypto prices"
    },
    {
      "name": "image-describe",
      "description": "Vision AI from URL"
    },
    {
      "name": "defi-yields",
      "description": "DeFi yield data"
    },
    {
      "name": "threat-intel",
      "description": "CVE/threat intelligence"
    },
    {
      "name": "sanctions-screen",
      "description": "OFAC/EU sanctions"
    },
    {
      "name": "market-intel",
      "description": "Macro/economic data"
    },
    {
      "name": "on-chain-events",
      "description": "On-chain events"
    },
    {
      "name": "content-safety",
      "description": "PII/toxicity detection"
    },
    {
      "name": "agent-reputation",
      "description": "Endpoint trustworthiness"
    },
    {
      "name": "legal-lookup",
      "description": "Company/VAT verification"
    },
    {
      "name": "news-feed",
      "description": "Real-time news"
    },
    {
      "name": "weather-data",
      "description": "Weather data"
    }
  ],
  "payment": {
    "protocol": "x402",
    "network": "eip155:8453",
    "currency": "USDC",
    "note": "Each tool call pays the agentpay.help endpoint via x402 automatic payment from BUYER_PRIVATE_KEY wallet."
  }
}